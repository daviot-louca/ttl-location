---
/**
 * Pop-up « Camion-aspirateur » (Figma 246:6639).
 * Ouvert par tout élément portant data-popup-aspiration-ouvrir.
 * « Ça m'intéresse » présélectionne la solution « aspiration » du formulaire et y fait défiler.
 */
import { ancres } from '../../data/navigation';

const points = ['Terrassement par aspiration', 'Curage et nettoyage', 'Évacuation des matériaux'];
---

<dialog
  id="popup-aspiration"
  aria-labelledby="popup-aspiration-titre"
  class="m-auto max-h-[calc(100dvh-32px)] w-[calc(100%-32px)] max-w-[900px] overflow-y-auto rounded-bloc bg-white p-0 backdrop:bg-ink/60 open:flex"
>
  <div class="relative hidden w-[420px] shrink-0 md:block">
    <img
      src="/assets/camion-aspirateur-popup.webp"
      alt="Camion-aspirateur Tragelux TTL en intervention devant une maison"
      class="absolute inset-0 size-full object-cover"
      loading="lazy"
    />
  </div>
  <div class="flex flex-1 flex-col items-start gap-[18px] p-7 md:p-11">
    <div class="flex w-full items-center justify-between">
      <p class="rounded-full bg-red px-3 py-1.5 text-[13px] font-semibold text-white">Travaux par aspiration</p>
      <button
        type="button"
        data-popup-fermer
        aria-label="Fermer"
        class="flex size-10 cursor-pointer items-center justify-center rounded-full bg-ground transition-colors hover:bg-soft"
      >
        <img src="/ui/icone-fermer-petit.svg" alt="" width="16" height="16" />
      </button>
    </div>
    <h2 id="popup-aspiration-titre" class="text-[26px] leading-[1.2] font-semibold text-ink md:text-[32px]">
      Vous devez creuser près de réseaux enterrés ?
    </h2>
    <p class="texte-lg text-muted">
      Avec notre camion-aspirateur, nous dégageons le sol sans abîmer câbles et canalisations, puis évacuons
      directement les matériaux. Service d’aspiration au Luxembourg.
    </p>
    <ul class="flex flex-col gap-2">
      {
        points.map((p) => (
          <li class="flex items-center gap-2.5 texte-label text-ink">
            <img src="/ui/puce-8.svg" alt="" width="8" height="8" />
            {p}
          </li>
        ))
      }
    </ul>
    <div class="flex items-center gap-4 pt-2">
      <a
        href={ancres.contact}
        data-popup-fermer
        data-preselection="solution:aspiration"
        class="rounded-full bg-red px-6 py-[15px] texte font-semibold text-white transition-colors hover:bg-darkred"
      >
        Ça m’intéresse
      </a>
      <button type="button" data-popup-fermer class="cursor-pointer texte-sm font-semibold text-muted hover:text-ink">
        Plus tard
      </button>
    </div>
  </div>
</dialog>

<script>
  const popup = document.getElementById('popup-aspiration') as HTMLDialogElement | null;

  document.querySelectorAll('[data-popup-aspiration-ouvrir]').forEach((el) =>
    el.addEventListener('click', (e) => {
      e.preventDefault();
      popup?.showModal();
    }),
  );
  popup?.querySelectorAll('[data-popup-fermer]').forEach((el) => el.addEventListener('click', () => popup.close()));
  // Clic sur le voile (hors de la carte) : fermeture.
  popup?.addEventListener('click', (e) => {
    if (e.target === popup) popup.close();
  });
</script>
