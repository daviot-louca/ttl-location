---
/**
 * Question FAQ (Figma 230:5073) — états Fermé / Ouvert, formats Mobile / Desktop (≥ 768 px).
 */
interface Props {
  question: string;
  reponse?: string;
  ouvert?: boolean;
  class?: string;
}

const { question, reponse, ouvert = false, class: className } = Astro.props;
---

<details
  open={ouvert}
  class:list={[
    'group w-full rounded-[20px] bg-white py-[18px] pr-4 pl-5 md:py-[22px] md:pr-[22px] md:pl-7',
    className,
  ]}
>
  <summary class="flex cursor-pointer list-none items-center gap-4">
    <span class="flex-1 text-left texte-question text-ink">{question}</span>
    <span
      class="flex size-9 shrink-0 items-center justify-center rounded-full bg-ground transition-colors group-open:bg-red"
    >
      <img src="/ui/icone-plus.svg" alt="" width="16" height="16" class="group-open:hidden" />
      <img src="/ui/icone-moins.svg" alt="" width="16" height="16" class="hidden group-open:block" />
    </span>
  </summary>
  <div class="mt-3 text-left texte text-muted">
    {reponse ? <p>{reponse}</p> : <slot />}
  </div>
</details>
