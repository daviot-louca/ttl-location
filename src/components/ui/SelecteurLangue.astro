---
/**
 * Sélecteur de langue (Figma 64:418). La langue active est en noir.
 * variante « sombre » = version du menu mobile (fond ghost, actif blanc).
 */
import { langues, type Langue } from '../../data/navigation';

interface Props {
  active?: Langue;
  variante?: 'clair' | 'sombre';
  class?: string;
}

const { active = 'fr', variante = 'clair', class: className } = Astro.props;
const sombre = variante === 'sombre';
---

<nav
  aria-label="Langue"
  class:list={[
    'inline-flex items-start rounded-full',
    sombre ? 'gap-1 bg-ghost p-1' : 'gap-0.5 bg-ground p-[3px]',
    className,
  ]}
>
  {
    langues.map(({ code, href }) => {
      const estActive = code === active;
      return (
        <a
          href={href}
          hreflang={code}
          aria-current={estActive ? 'true' : undefined}
          class:list={[
            'rounded-full py-2 texte-xs font-semibold uppercase transition-colors',
            sombre ? 'px-3.5' : 'px-3 tracking-[0.28px]',
            estActive && (sombre ? 'bg-white text-ink' : 'bg-ink text-white'),
            !estActive && (sombre ? 'text-grey hover:text-white' : 'text-ink hover:bg-soft'),
          ]}
        >
          {code}
        </a>
      );
    })
  }
</nav>
