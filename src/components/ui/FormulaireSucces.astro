---
/** Formulaire — envoi réussi (Figma « V1 · Overlay — Demande envoyée », 235:5777). */
import Bouton from './Bouton.astro';

interface Props {
  titre?: string;
  texte?: string;
  boutonLabel?: string;
  boutonHref?: string;
  class?: string;
}

const {
  titre = 'Merci ! Nous avons bien reçu votre demande.',
  texte = 'Nous revenons vers vous par e-mail ou par téléphone. Une copie vous a été envoyée.',
  boutonLabel = 'Retour à l’accueil',
  boutonHref = '#top',
  class: className,
} = Astro.props;
---

<div
  role="status"
  class:list={['flex w-full max-w-[640px] flex-col items-start gap-4 rounded-bloc bg-white p-8 md:p-12', className]}
>
  <span class="flex size-14 items-center justify-center rounded-[28px] bg-ink">
    <img src="/ui/icone-check.svg" alt="" width="24" height="24" />
  </span>
  <p class="titre-2 text-ink">
    {titre}
  </p>
  <p class="texte-lg text-ink">{texte}</p>
  <Bouton label={boutonLabel} style="blanc" href={boutonHref} data-succes-fermer />
</div>
