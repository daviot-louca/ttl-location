---
/** Landing page TTL Location (Figma « Landing V1 », 228:5047). */
import Layout from '../../layouts/Layout.astro';
import Bouton from '../../components/ui/Bouton.astro';
import TuileService from '../../components/ui/TuileService.astro';
import CarteGrue from '../../components/ui/CarteGrue.astro';
import BandeContact from '../../components/ui/BandeContact.astro';
import QuestionFaq from '../../components/ui/QuestionFaq.astro';
import FormulaireContact from '../../components/ui/FormulaireContact.astro';
import PopupAspiration from '../../components/ui/PopupAspiration.astro';
import { ancres, contact } from '../../data/navigation';
import { domainesLanding, chiffres, servicesLanding, grues, garanties, faq, horaires } from '../../data/landing';

// Conteneur commun des sections : 1440 px max, gouttières 40 px en desktop.
const conteneur = 'mx-auto w-full max-w-360 px-5 md:px-10';
---

<Layout title="TTL Location — Solutions de chantier au Luxembourg">
  <main id="top">
    <!-- Hero vidéo (228:5049) -->
    <section class="mx-auto max-w-360 px-2 pt-2 md:px-3 md:pt-3">
      <div class="relative flex h-[calc(100svh-86px)] max-h-[720px] min-h-[560px] items-end overflow-hidden rounded-bloc bg-ink">
        <video
          id="hero-video"
          class="absolute inset-0 size-full object-cover"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          aria-hidden="true"
        >
          <source src="/assets/2026-09-25-07-50-24-221.webm" type="video/webm" />
          <source src="/assets/2026-09-25-07-50-24-221.mp4" type="video/mp4" />
        </video>
        <div class="absolute inset-0 bg-black/48"></div>

        <div class="relative flex max-w-[1100px] flex-col items-start gap-6 px-5 pb-10 md:px-16 md:pb-16">
          <h1 class="titre-hero text-white">
            Toutes vos solutions <br class="hidden md:block" />de chantier au Luxembourg.
          </h1>
          <p class="max-w-[620px] text-[17px] leading-[1.45] text-soft md:text-[20px]">
            Levage de charges lourdes, excavation par aspiration, transport exceptionnel, travaux de voirie ou
            autorisations : depuis Mamer, nous vous accompagnons partout au Luxembourg.
          </p>
          <Bouton label="Parlez-nous de votre projet" fleche href={ancres.contact} />
        </div>
      </div>
    </section>

    <!-- À propos (228:5362) -->
    <section id="a-propos" class:list={[conteneur, 'pt-16']}>
      <div class="flex flex-col gap-10 lg:flex-row lg:items-center lg:gap-12">
        <div class="flex flex-1 flex-col gap-[22px] text-ink">
          <h2 class="titre-display max-w-[640px]">Un partenaire de chantier près de chez vous.</h2>
          <p class="max-w-[580px] text-[17px] leading-normal md:text-[19px]">
            Depuis 1991, TTL Location accompagne les professionnels, les communes et les administrations dans leurs
            projets au Luxembourg. Basés à Mamer, nous mettons plus de 35 ans d’expérience au service de votre
            chantier.
          </p>
        </div>
        <img
          src="/assets/cadeau.webp"
          alt="Grue TTL Location installant un paquet cadeau géant de nuit à Luxembourg-ville"
          width="709"
          height="531"
          class="h-[320px] w-full rounded-bloc object-cover md:h-[500px] lg:w-[640px] lg:shrink-0"
        />
      </div>
    </section>

    <!-- Domaines d'intervention (228:5080) -->
    <section id="domaines" class:list={[conteneur, 'flex flex-col gap-10 pt-20 lg:pt-30']}>
      <div class="flex flex-col gap-3">
        <h2 class="titre-section text-ink">Votre projet, votre secteur</h2>
        <p class="texte-intro text-muted">
          Vous êtes une commune, un pisciniste, un agriculteur ou un industriel ? Choisissez votre secteur : nous
          adaptons notre réponse.
        </p>
      </div>
      <div class="grid gap-3 md:grid-cols-3">
        {
          domainesLanding.map((d) => (
            <a
              href={ancres.contact}
              data-preselection={`domaine:${d.valeur}`}
              data-reveal
              class="group flex flex-col overflow-hidden rounded-carte bg-white text-left transition-shadow hover:shadow-menu"
            >
            
              <img
                src={d.image}
                alt={d.imageAlt}
                loading="lazy"
                class="h-[200px] w-full object-cover transition-transform duration-500 group-hover:scale-[1.04] md:h-[260px]"
              />
              <div class="flex flex-col gap-2.5 px-6 pt-6 pb-[26px]">
                <h3 class="text-ink">{d.titre}</h3>
                <p class="texte text-muted">{d.texte}</p>
              </div>
            </a>
          ))
        }
      </div>
    </section>

    <!-- Chiffres (228:5369) -->
    <section class="mx-auto max-w-360 px-2 pt-20 md:px-3 lg:pt-30">
      <div class="grid grid-cols-2 gap-x-6 gap-y-10 rounded-bloc bg-red px-6 py-12 text-white md:p-20 lg:flex lg:justify-between">
        {
          chiffres.map((c) => (
            <div class="flex flex-col gap-2">
              <p class="chiffre">{c.valeur}</p>
              <p class="texte md:texte-intro">{c.legende}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Services (228:5119) -->
    <section id="services" class:list={[conteneur, 'flex flex-col gap-8 pt-20 lg:pt-30']}>
      <div class="flex flex-col items-start gap-4 md:flex-row md:items-end md:justify-between">
        <h2 class="titre-section text-ink">Comment pouvons-nous vous aider ?</h2>
        <a href={ancres.contact} class="texte-bouton text-red underline hover:text-darkred">Parlez-nous de votre besoin</a>
      </div>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {
          servicesLanding.map((s) =>
            s.valeur === 'aspiration' ? (
              <TuileService
                titre={s.titre}
                texte={s.texte}
                image={s.image}
                imageAlt={s.imageAlt}
                cadrage={s.cadrage}
                data-popup-aspiration-ouvrir
              />
            ) : (
              <TuileService
                titre={s.titre}
                texte={s.texte}
                image={s.image}
                imageAlt={s.imageAlt}
                cadrage={s.cadrage}
                data-preselection={`solution:${s.valeur}`}
              />
            ),
          )
        }
        <div class="flex min-h-[320px] flex-col items-start justify-between gap-8 rounded-carte bg-dark p-8">
          <h3 class="titre-2 max-w-[381px] text-balance text-white">Une demande spécifique ?</h3>
          <div class="flex flex-col items-start gap-8">
            <p class="texte text-light">Décrivez-nous votre opération : nous trouvons la solution avec vous.</p>
            <Bouton label="Parlez-nous-en" style="blanc" fleche href={ancres.contact} />
          </div>
        </div>
      </div>
    </section>

    <!-- Véhicules de levage (228:5133) -->
    <section class:list={[conteneur, 'flex flex-col gap-8 pt-20 lg:pt-30']}>
      <h2 class="titre-section text-ink">La grue qu’il vous faut</h2>
      <div class="grid gap-3 md:grid-cols-3">
        {grues.map((g) => <CarteGrue grue={g} />)}
      </div>
    </section>

    <!-- Bande contact (228:5181) -->
    <div class:list={[conteneur, 'py-20']}>
      <BandeContact
        titre="Prêt à lancer votre chantier ?"
        texte="Décrivez votre besoin : nous vous répondons par e-mail ou par téléphone."
      />
    </div>

    <!-- Points forts (228:5383) -->
    <section class:list={[conteneur, 'flex flex-col gap-7 lg:pt-10']}>
      <h2 class="titre-section text-ink">Ce que nous vous garantissons</h2>
      <div class="grid gap-3 md:grid-cols-3">
        {
          garanties.map((g) => (
            <div class="flex flex-col gap-3 rounded-carte bg-white p-8">
              <h3 class="text-[28px] tracking-[-0.02em] text-ink">{g.titre}</h3>
              <p class="texte text-muted">{g.texte}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- FAQ (228:5141) -->
    <section id="faq" class:list={[conteneur, 'flex flex-col gap-10 pt-20 lg:pt-30']}>
      <h2 class="titre-section text-ink">Vos questions, nos réponses</h2>
      <div class="mx-auto flex w-full max-w-[960px] flex-col gap-2.5">
        {faq.map((q, i) => <QuestionFaq question={q.question} reponse={q.reponse} ouvert={i === 0} />)}
      </div>
    </section>

    <!-- Coordonnées et formulaire (228:5481) -->
    <section id="contact" class:list={[conteneur, 'pt-12 pb-10']}>
      <div class="flex flex-col gap-3 lg:flex-row lg:items-start">
        <address class="flex flex-col gap-7 rounded-bloc bg-dark p-8 not-italic md:p-12 lg:w-[520px] lg:shrink-0 lg:self-stretch">
          <div class="flex flex-col gap-1">
            <p class="texte-sm text-light">Téléphone</p>
            <a href={contact.telephoneHref} class="text-[28px] leading-[1.3] font-semibold tracking-[-0.02em] text-white hover:underline md:text-[34px]">
              {contact.telephone}
            </a>
          </div>
          <div class="flex flex-col gap-1">
            <p class="texte-sm text-light">E-mail</p>
            <a href={`mailto:${contact.email}`} class="titre-4 leading-[1.3] text-white hover:underline">{contact.email}</a>
          </div>
          <div class="flex flex-col gap-1">
            <p class="texte-sm text-light">Adresse</p>
            <p class="titre-4 leading-[1.3] text-white">
              {contact.adresse[0]}<br />{contact.adresse[1]}
            </p>
          </div>
          <div class="flex flex-col gap-1">
            <p class="texte-sm text-light">Horaires</p>
            <p class="titre-4 leading-[1.3] text-white/60">
              {horaires[0]}<br />{horaires[1]}
            </p>
          </div>
          <div class="flex flex-col gap-1">
            <p class="texte-sm text-light">Instagram</p>
            <a href="https://www.instagram.com/ttl_location/" class="titre-4 text-white hover:underline">{contact.instagram}</a>
          </div>
          <iframe
            title="Plan d’accès — TTL Location, 28 Rue du Baerendall, Mamer"
            src="https://www.google.com/maps?q=28+Rue+du+Baerendall,+8212+Mamer,+Luxembourg&output=embed"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            class="h-[220px] w-full rounded-carte border-0 bg-ink"
          ></iframe>
        </address>

        <FormulaireContact class="min-w-0 flex-1" />
      </div>
    </section>
  </main>

  <PopupAspiration />
</Layout>

<script>
  const revealCards = document.querySelectorAll<HTMLElement>('[data-reveal]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (revealCards.length && !reduceMotion && 'IntersectionObserver' in window) {
    revealCards.forEach((card, index) => {
      card.dataset.revealDelay = String(index);
    });
    document.documentElement.classList.add('motion-ready');

    const revealObserver = new IntersectionObserver((entries, observer) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.15 });

    revealCards.forEach((card) => revealObserver.observe(card));
  }

  const video = document.querySelector<HTMLVideoElement>('#hero-video');

  if (video) {
    video.muted = true;
    video.defaultMuted = true;
    video.playsInline = true;

    // Mouvement réduit demandé : pas de lecture automatique.
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      video.pause();
    } else {
      video.play().catch(() => {
        /* Lecture automatique bloquée par le navigateur : la première image reste affichée. */
      });
    }
  }
</script>
